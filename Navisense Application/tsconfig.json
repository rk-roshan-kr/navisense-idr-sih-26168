{
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "resolveJsonModule": true,
    "customConditions": ["react-native"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
