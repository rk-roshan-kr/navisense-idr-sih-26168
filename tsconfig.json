{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "typeRoots": [
      "./Navisense Application/node_modules/@types"
    ]
  },
  "include": [
    "Navisense Application/**/*.ts",
    "Navisense Application/**/*.tsx"
  ]
}
